BOT_TOKEN=your-max-bot-token
RESPONSIBLE_IDS=123456789,987654321
ADMIN_IDS=123456789
ADMIN_PASSWORD=super-secret-password

# Стадия запуска по умолчанию (до переключения в админ-панели):
# beta        — доступ только тестировщикам (по кнопке «Хочу в бета-тест»)
# public_beta — доступен всем
# final       — финальный выход, работает 24/7
BOT_STAGE=beta

# SQLite (test)
DB_DRIVER=sqlite
DB_PATH=local_db/postobot.db

# PostgreSQL (prod) — uncomment and set when deploying
# DATABASE_URL=postgres://user:pass@localhost:5432/postobot?sslmode=disable

ARCHIVE_DIR=data/archive
MAT_WORDS=свои мат слова,которые,вы,хотите,запретить
SPAM_WORD=спам,слова,через,запятую

# TLS для Max API (macOS не доверяет Russian Trusted CA):
# 1) свой файл корневого сертификата, или
# 2) dev-only: отключить проверку.
# CA_CERT_FILE=/path/to/russian-trusted-root.pem
# INSECURE_SKIP_VERIFY=true